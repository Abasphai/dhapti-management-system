# Frontend (Vite) — copy to `.env`
# Restart Vite after changing VITE_* values.

# Local: use the Vite proxy (recommended):
VITE_API_URL=/api

# Or call the API directly (requires matching CORS on the backend):
# VITE_API_URL=http://127.0.0.1:4000/api

# Production (Vercel): set an absolute Render API URL in the Vercel dashboard:
# VITE_API_URL=https://dhapti-university.onrender.com/api
# Optional override used when VITE_API_URL is empty/relative on a live host:
# VITE_PRODUCTION_API_URL=https://dhapti-university.onrender.com/api
