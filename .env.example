# Frontend (Vite) — copy to `.env`
# Restart Vite after changing VITE_* values.

# Local + Vercel production: relative `/api`
# - Local: Vite proxies /api → http://127.0.0.1:4000
# - Production: Vercel rewrites /api → serverless Express (api/index.ts)
VITE_API_URL=/api

# Optional absolute override (rarely needed once API is on Vercel):
# VITE_API_URL=http://127.0.0.1:4000/api
