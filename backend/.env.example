# Backend — copy to `backend/.env` and fill in your NEW Supabase project.
# Get connection strings from Supabase Dashboard > Project Settings > Database > Connect.

# Transaction pooler (port 6543) — use for DATABASE_URL in production/serverless
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true&sslmode=require"

# Direct connection (port 5432) — required for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[DIRECT_HOST]:5432/postgres?sslmode=require"

# Local SQLite fallback (optional, dev only):
# DATABASE_URL="file:./dev.db"

# REQUIRED — generate a long random string (min 32 chars in production)
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

UPLOAD_DIR=uploads
FILE_STORAGE_PATH=storage/private
FILE_STORAGE_TMP=storage/tmp
MAX_FILE_SIZE_MB=500

FRONTEND_ORIGIN=https://dhapti.com,https://www.dhapti.com,http://localhost:5173,http://localhost:5174

ALLOW_DEV_ADMIN_REGISTER=false
