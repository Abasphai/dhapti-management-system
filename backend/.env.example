# Supabase PostgreSQL — copy exact host from Dashboard > Connect (may be aws-0, aws-1, etc.)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# Local SQLite fallback:
# DATABASE_URL="file:./dev.db"
# REQUIRED — generate a long random string (min 32 chars in production)
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# Public static assets only (NOT private assignment submissions)
UPLOAD_DIR=uploads
# Private file storage root (assignment submissions). Never mount publicly.
FILE_STORAGE_PATH=storage/private
FILE_STORAGE_TMP=storage/tmp
MAX_FILE_SIZE_MB=500

# Comma-separated CORS allowlist
FRONTEND_ORIGIN=https://dhapti.com,https://www.dhapti.com,https://dhapti-university.vercel.app,https://dhapti-university-77po.vercel.app,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Set true to allow any browser Origin (emergency / multi-preview). Prefer FRONTEND_ORIGIN.
# CORS_ALLOW_ALL=false

# Dev-only admin bootstrap endpoint (POST /api/auth/register-admin)
# Must be exactly "true" to enable; ignored / blocked in production
ALLOW_DEV_ADMIN_REGISTER=false
