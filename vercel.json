{
  "version": 2,
  "functions": {
    "api/[[...path]].ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{backend/dist/**,node_modules/.prisma/client/**,node_modules/@prisma/client/**,node_modules/.prisma/**}"
    }
  },
  "rewrites": [
    {
      "handle": "filesystem"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
