{
  "version": 2,
  "installCommand": "npm install && npm install --prefix backend",
  "buildCommand": "npm --prefix backend exec prisma generate && npm run build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "backend/node_modules/.prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
